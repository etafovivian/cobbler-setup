## ============================================================================
## RHEL 9 Kickstart — Cobbler Managed
## Generated by Ansible; served by Cobbler at install time.
## Supports both UEFI and Legacy BIOS installations.
## ============================================================================

## --- Installation method ---
## Cobbler Cheetah variable $tree resolves to the HTTP repo URL
#set $tree = "http://" + $http_server + "/cblr/links/" + $distro_name
url --url=$tree
text
reboot

## --- Localization ---
lang {{ cobbler_lang }}
keyboard {{ cobbler_keyboard }}
timezone {{ cobbler_timezone }} --utc --ntpservers={{ cobbler_ntp_servers | join(',') }}

## --- Network ---
## Use DHCP during install; configure static IP post-install if needed
$kickstart_start
network --bootproto=dhcp --device=link --activate --onboot=yes
network --hostname=localhost.localdomain

## --- Authentication ---
rootpw --iscrypted {{ cobbler_default_password_crypted }}

## --- Security ---
selinux --{{ cobbler_selinux_mode }}
firewall --enabled --ssh

## --- Bootloader ---
## Anaconda auto-detects UEFI vs BIOS firmware
bootloader --location=mbr --append="crashkernel=auto"

## --- Disk Partitioning ---
## Clear all existing partitions and initialize disk labels.
## Both EFI and biosboot partitions are declared — Anaconda skips
## whichever is irrelevant for the detected firmware type.
zerombr
clearpart --all --initlabel --drives={{ cobbler_install_disk }}

## EFI System Partition (UEFI only; ignored on BIOS)
part /boot/efi --fstype=efi --size={{ cobbler_part_efi_size }} --ondisk={{ cobbler_install_disk }}

## BIOS Boot Partition (BIOS+GPT only; ignored on UEFI)
part biosboot --fstype=biosboot --size={{ cobbler_part_biosboot_size }} --ondisk={{ cobbler_install_disk }}

## /boot — outside LVM for GRUB access
part /boot --fstype=xfs --size={{ cobbler_part_boot_size }} --ondisk={{ cobbler_install_disk }}

## LVM physical volume — remainder of disk
part pv.01 --size=1 --grow --ondisk={{ cobbler_install_disk }}

volgroup {{ cobbler_vg_name }} pv.01

{% if cobbler_part_root_size == 0 %}
logvol / --fstype=xfs --name=root --vgname={{ cobbler_vg_name }} --size=1 --grow
{% else %}
logvol / --fstype=xfs --name=root --vgname={{ cobbler_vg_name }} --size={{ cobbler_part_root_size }}
{% endif %}
logvol swap --fstype=swap --name=swap --vgname={{ cobbler_vg_name }} --size={{ cobbler_part_swap_size }}

## --- Package Selection ---
%packages --ignoremissing
@^minimal-environment
@standard
{% for pkg in cobbler_extra_packages %}
{{ pkg }}
{% endfor %}
%end

## --- Post-install Script ---
%post --log=/root/ks-post.log

## Enable chrony for time sync
systemctl enable chronyd

cat > /etc/chrony.conf << 'CHRONYEOF'
{% for ntp in cobbler_ntp_servers %}
server {{ ntp }} iburst
{% endfor %}
driftfile /var/lib/chrony/drift
makestep 1.0 3
rtcsync
logdir /var/log/chrony
CHRONYEOF

## Ensure SSH is enabled
systemctl enable sshd

## Log completion
echo "Kickstart post-install completed at $(date)" >> /root/ks-post.log

## Inform Cobbler that install is complete (disables PXE for this system)
$SNIPPET('post_anamon')

%end
