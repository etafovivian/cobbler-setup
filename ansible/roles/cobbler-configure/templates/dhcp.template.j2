## ============================================================================
## Cobbler-managed dhcpd.conf
## WARNING: This file is managed by Ansible + Cobbler.
## Ansible deploys this to /etc/cobbler/dhcp.template
## Cobbler processes it (Cheetah syntax: $var) and writes /etc/dhcp/dhcpd.conf
## Manual edits to either file will be overwritten.
## ============================================================================

ddns-update-style interim;
allow booting;
allow bootp;

ignore client-updates;
set vendorclass = option vendor-class-identifier;

option pxe-system-type code 93 = unsigned integer 16;

## ============================================================================
## SUBNET CONFIGURATION
## ============================================================================

subnet {{ cobbler_subnet }} netmask {{ cobbler_netmask }} {
    option routers             {{ cobbler_gateway }};
    option domain-name         "{{ cobbler_domain }}";
    option domain-name-servers {{ cobbler_dns_servers | join(', ') }};
    option subnet-mask         {{ cobbler_netmask }};
    range dynamic-bootp        {{ cobbler_dhcp_range_start }} {{ cobbler_dhcp_range_end }};
    default-lease-time         {{ cobbler_dhcp_default_lease }};
    max-lease-time             {{ cobbler_dhcp_max_lease }};
    next-server                $next_server_v4;

    ## ========================================================================
    ## ARCHITECTURE-BASED BOOT LOADER SELECTION
    ## DHCP option 93 (pxe-system-type) identifies firmware:
    ##   0x0000 = Legacy BIOS (Intel x86PC)
    ##   0x0006 = UEFI IA32
    ##   0x0007 = UEFI x86_64
    ##   0x0008 = UEFI x86_64 (Xen)
    ##   0x0009 = UEFI x86_64 (EBC)
    ## ========================================================================

    class "pxeclients" {
        match if substring (option vendor-class-identifier, 0, 9) = "PXEClient";

        if option pxe-system-type = 00:07 or option pxe-system-type = 00:08 or option pxe-system-type = 00:09 {
            ## UEFI 64-bit — serve shimx64.efi (Secure Boot compatible)
            filename "grub/shimx64.efi";
        } else if option pxe-system-type = 00:06 {
            ## UEFI 32-bit
            filename "grub/shimia32.efi";
        } else {
            ## Legacy BIOS
            filename "pxelinux.0";
        }
    }
}

## ============================================================================
## COBBLER-MANAGED HOST ENTRIES
## Generated automatically by 'cobbler sync' from system records.
## ============================================================================

#for dhcp_tag in $dhcp_tags.keys():
    ## group for Cobbler DHCP tag: $dhcp_tag
    group {
        #for mac in $dhcp_tags[$dhcp_tag].keys():
            #set iface = $dhcp_tags[$dhcp_tag][$mac]
        host $iface.name {
            hardware ethernet $mac;
            #if $iface.ip_address:
            fixed-address $iface.ip_address;
            #end if
            #if $iface.hostname:
            option host-name "$iface.hostname";
            #end if
            #if $iface.filename:
            filename "$iface.filename";
            #end if
            #if $iface.next_server_v4:
            next-server $iface.next_server_v4;
            #end if
        }
        #end for
    }
#end for
