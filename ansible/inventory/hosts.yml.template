---
# =============================================================================
# Cobbler Setup Inventory Template
# Copy to hosts.yml and fill in real values before running any playbook.
# hosts.yml is in .gitignore — never commit it.
# =============================================================================

all:
  vars:
    ansible_user: root
    ansible_ssh_private_key_file: ~/.ssh/id_ed25519
    ansible_python_interpreter: /usr/bin/python3

cobbler:
  hosts:
    dns:
      ansible_host: 192.168.5.7
      cobbler_interface: ens192
