---
# =============================================================================
# Cobbler Setup Inventory Template
# Copy to hosts.yml and fill in real values before running any playbook.
# hosts.yml is in .gitignore — never commit it.
# =============================================================================

all:
  vars:
    ansible_user: root
    ansible_ssh_private_key_file: ~/.ssh/id_rsa
    ansible_python_interpreter: /usr/bin/python3

cobbler:
  hosts:
    cobbler-server:
      ansible_host: 192.168.1.10       # CHANGE: Cobbler server IP
      cobbler_interface: eth0            # CHANGE: NIC for PXE/DHCP traffic
